{
  "name": "pipecraft",
  "version": "1.0.1",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "desktop:build": "prisma generate && next build && node scripts/prepare-desktop.mjs",
    "desktop:run": "bun run desktop:build && electron .",
    "dist:win": "bun run desktop:build && electron-builder --win",
    "dist:mac": "bun run desktop:build && electron-builder --mac",
    "dist:linux": "bun run desktop:build && electron-builder --linux"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@dagrejs/dagre": "^1.1.5",
    "@monaco-editor/react": "^4.6.0",
    "@octokit/plugin-throttling": "^9.2.5",
    "@octokit/rest": "^21.0.0",
    "@xyflow/react": "^12.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "html-to-image": "^1.11.13",
    "immer": "^10.1.0",
    "lz-string": "^1.5.0",
    "monaco-yaml": "5.1.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.2.0",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.6.1",
    "react-resizable-panels": "^2.1.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8",
    "zundo": "^2.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@prisma/client": "^5.20.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.72.0",
    "postcss": "^8.4.49",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "wrangler": "4.148.0"
  },
  "description": "Visual CI/CD pipeline editor for GitHub Actions.",
